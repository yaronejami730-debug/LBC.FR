{
  "key": "immobilier.location-longue-duree.appartement",
  "version": 1,
  "status": "published",
  "label": "Appartement — Location longue durée",
  "icon": "key",
  "extends": ["_base.listing", "_mixin.habitation"],
  "taxonomy": { "category": "immobilier", "subcategory": "location-longue-duree", "listing_type": "appartement", "path_labels": ["Immobilier", "Location longue durée", "Appartement"] },
  "transaction_types": ["location_longue_duree"],
  "default_transaction_type": "location_longue_duree",

  "fields": [
    { "ref": "loyer_mensuel",      "step": "tarification", "order": 1, "required": true, "facet": true, "seo_attr": true },
    { "ref": "charges_mensuelles", "step": "tarification", "order": 2, "required": true },
    { "ref": "depot_garantie",     "step": "tarification", "order": 3, "required": true },
    { "ref": "honoraires",         "step": "tarification", "order": 4 },
    { "ref": "meuble",             "step": "type",         "order": 2, "required": true, "facet": true, "seo_attr": true },
    { "ref": "type_bail",          "step": "conditions",   "order": 1, "required": true },
    { "ref": "duree_bail",         "step": "conditions",   "order": 2, "required": true },
    { "ref": "disponibilite_le",   "step": "conditions",   "order": 3, "required": true, "facet": true },
    { "ref": "colocation_ok",      "step": "conditions",   "order": 4 },
    { "ref": "garant_exige",       "step": "conditions",   "order": 5 },
    { "ref": "revenus_exiges",     "step": "conditions",   "order": 6 },
    { "ref": "equipements_logement", "step": "equipements", "order": 1, "visible_if": { "==": [{ "var": "attributes.meuble" }, true] }, "facet": true },
    { "ref": "dpe",                "step": "caracteristiques", "order": 50, "required": true, "facet": true },
    { "ref": "ges",                "step": "caracteristiques", "order": 51, "required": true }
  ],

  "pricing": { "model": "single", "currency": "EUR", "charges": true, "deposit": true, "negotiable": false, "hide_price_allowed": false },
  "availability": { "mode": "date_single" },

  "display": {
    "template": "realestate",
    "title_pattern": "{type_bien} {nb_pieces} pièces {meuble_label} à louer — {ville}",
    "blocks": [
      { "type": "hero_gallery", "options": { "group_by": "space" } },
      { "type": "price_block", "options": { "show_charges": true, "show_deposit": true, "suffix": "/mois" } },
      { "type": "key_facts", "fields": ["surface", "nb_pieces", "nb_chambres", "meuble", "etage", "disponibilite_le"] },
      { "type": "description" },
      { "type": "amenities", "fields": ["equipements_logement", "exterieurs", "services_bien"] },
      { "type": "energy_diagram", "fields": ["dpe", "ges"] },
      { "type": "map", "options": { "respect_precision": true } },
      { "type": "conditions", "label": "Conditions de location", "fields": ["type_bail", "duree_bail", "depot_garantie", "garant_exige", "revenus_exiges", "colocation_ok"] },
      { "type": "documents" },
      { "type": "seller_card" },
      { "type": "similar" },
      { "type": "cta_bar", "options": { "primary": "Candidater / demander une visite" } }
    ],
    "card": { "primary_price": "loyer", "facts": ["surface", "nb_pieces", "meuble"], "badges": ["dpe", "disponibilite_le"] }
  },

  "validation": [
    { "id": "encadrement_loyers", "severity": "warning",
      "when": { "and": [{ "var": "city.rent_control" }, { ">": [{ "var": "computed.loyer_m2" }, { "var": "city.rent_ceiling_m2" }] }] },
      "message": "Votre loyer dépasse le plafond d'encadrement en vigueur dans cette commune.", "field": "loyer_mensuel" },
    { "id": "dpe_passoire", "severity": "warning",
      "when": { "in": [{ "var": "attributes.dpe" }, ["F", "G"]] },
      "message": "Les logements classés F et G sont progressivement interdits à la location. Vérifiez votre éligibilité.", "field": "dpe" }
  ],

  "seo": {
    "url_pattern": "/immobilier/location/appartement/{city_slug}/{id}-{title_slug}",
    "schema_org": ["Apartment", "Offer", "RealEstateListing"],
    "title_pattern": "Appartement {nb_pieces} pièces à louer à {ville} — {loyer_mensuel}/mois | Deal&Co",
    "h1_pattern": "Appartement {nb_pieces} pièces {meuble_label} à louer — {ville}",
    "hub_pages": true
  },

  "classifier": {
    "head_nouns": ["appartement", "appart", "studio", "t1", "t2", "t3", "t4", "f2", "f3", "logement", "colocation", "chambre"],
    "modifiers": ["charges comprises", "cc", "hc", "dépôt de garantie", "bail", "garant", "libre le", "meublé", "non meublé"],
    "negative": ["utilitaire", "fourgon", "kilométrage"],
    "transaction_cues": { "location_longue_duree": ["à louer", "location", "loue", "loyer", "mensuel", "par mois", "/mois", "bail", "longue durée", "à l'année", "étudiant", "colocation"] },
    "prior": 1.0
  }
}
