{
  "key": "immobilier.location-vacances.appartement",
  "version": 1,
  "status": "published",
  "label": "Appartement — Location de vacances",
  "short_label": "Location saisonnière",
  "icon": "palmtree",
  "extends": ["_base.listing", "_mixin.habitation"],
  "taxonomy": {
    "category": "immobilier",
    "subcategory": "location-vacances",
    "listing_type": "appartement",
    "path_labels": ["Immobilier", "Location de vacances", "Appartement"]
  },
  "transaction_types": ["location_saisonniere"],
  "default_transaction_type": "location_saisonniere",

  "steps": [
    { "key": "informations",     "label": "Votre logement",        "order": 3 },
    { "key": "capacite",         "label": "Capacité d'accueil",    "order": 4, "icon": "users" },
    { "key": "tarification",     "label": "Vos tarifs",            "subtitle": "Renseignez uniquement les formules que vous proposez", "order": 5 },
    { "key": "disponibilites",   "label": "Disponibilités",        "order": 6 },
    { "key": "equipements",      "label": "Équipements et services", "order": 7 },
    { "key": "medias",           "label": "Photos du logement",    "subtitle": "Une photo par pièce augmente les réservations de 40 %", "order": 8 },
    { "key": "localisation",     "label": "Où se situe le logement ?", "order": 9 },
    { "key": "conditions",       "label": "Règles et conditions",  "order": 10 },
    { "key": "apercu",           "label": "Aperçu et publication", "order": 11 }
  ],

  "fields": [
    { "ref": "nb_couchages",  "step": "capacite", "order": 1, "required": true, "facet": true, "seo_attr": true },
    { "ref": "capacite_max",  "step": "capacite", "order": 2, "required": true, "facet": true },
    { "ref": "nb_chambres",   "step": "capacite", "order": 3, "required": true, "facet": true, "seo_attr": true },
    { "ref": "nb_sdb",        "step": "capacite", "order": 4, "required": true },

    { "ref": "tarifs",        "step": "tarification", "order": 1, "required": true },
    { "ref": "frais_menage",  "step": "tarification", "order": 10 },
    { "ref": "menage_inclus", "step": "tarification", "order": 11 },
    { "ref": "caution",       "step": "tarification", "order": 12 },
    { "ref": "taxe_sejour",   "step": "tarification", "order": 13 },

    { "ref": "calendrier",    "step": "disponibilites", "order": 1, "required": true },
    { "ref": "nuits_min",     "step": "disponibilites", "order": 2, "required": true, "facet": true },
    { "ref": "nuits_max",     "step": "disponibilites", "order": 3 },
    { "ref": "check_in",      "step": "disponibilites", "order": 4 },
    { "ref": "check_out",     "step": "disponibilites", "order": 5 },

    { "ref": "equipements_logement", "step": "equipements", "order": 1, "required": true, "facet": true, "seo_attr": true },

    { "ref": "animaux_acceptes",  "step": "conditions", "order": 1, "facet": true },
    { "ref": "fumeur_autorise",   "step": "conditions", "order": 2 },
    { "ref": "fetes_autorisees",  "step": "conditions", "order": 3 },
    { "ref": "annulation",        "step": "conditions", "order": 4, "required": true },
    { "ref": "reglement_interieur", "step": "conditions", "order": 5 },
    { "ref": "numero_enregistrement", "step": "conditions", "order": 10,
      "required_if": { "in": [{ "var": "attributes.ville" }, ["Cannes", "Nice", "Paris", "Antibes", "Marseille", "Bordeaux", "Lyon", "Annecy", "Saint-Malo", "Biarritz"]] },
      "overrides": { "help": "Obligatoire dans votre commune pour toute location de courte durée." } }
  ],

  "pricing": {
    "model": "multi_rate",
    "currency": "EUR",
    "require_at_least_one_rate": true,
    "seasons": true,
    "deposit": true,
    "negotiable": false,
    "hide_price_allowed": false,
    "rates": [
      { "key": "nuit",       "unit": "night",   "label": "Par nuit",       "hint": "ex. 180 €", "min": 10, "max": 20000 },
      { "key": "week_end",   "unit": "weekend", "label": "Week-end (2 nuits)" },
      { "key": "semaine",    "unit": "week",    "label": "Par semaine",    "hint": "ex. 1 100 €" },
      { "key": "quinzaine",  "unit": "week",    "label": "Par quinzaine" },
      { "key": "mois",       "unit": "month",   "label": "Par mois",       "hint": "ex. 3 500 €" }
    ],
    "extras": [
      { "key": "menage",   "label": "Forfait ménage", "unit": "séjour", "included_toggle": true },
      { "key": "draps",    "label": "Location de draps et linge", "unit": "personne", "included_toggle": true },
      { "key": "parking",  "label": "Place de parking", "unit": "séjour", "included_toggle": true },
      { "key": "animal",   "label": "Supplément animal", "unit": "séjour" }
    ]
  },

  "availability": {
    "mode": "calendar",
    "min_duration_field": "nuits_min",
    "max_duration_field": "nuits_max",
    "blocked_periods": true,
    "period_pricing": true,
    "checkin_checkout": true,
    "instant_booking": true
  },

  "display": {
    "template": "stay",
    "title_pattern": "{type_bien} {nb_chambres} chambres{vue_suffix} à {ville}",
    "blocks": [
      { "type": "hero_gallery", "options": { "group_by": "space", "show_room_tabs": true } },
      { "type": "key_facts", "fields": ["capacite_max", "nb_chambres", "nb_couchages", "nb_sdb", "surface"] },
      { "type": "rates_table", "label": "Tarifs", "options": { "only_filled": true, "show_seasons": true } },
      { "type": "calendar", "label": "Disponibilités" },
      { "type": "description" },
      { "type": "amenities", "label": "Ce que propose ce logement", "fields": ["equipements_logement", "exterieurs", "services_bien"] },
      { "type": "floorplan", "visible_if": { "!!": { "var": "media.plan" } } },
      { "type": "map", "label": "Où vous serez", "options": { "respect_precision": true, "show_poi": true } },
      { "type": "conditions", "label": "Règles du logement", "fields": ["animaux_acceptes", "fumeur_autorise", "fetes_autorisees", "check_in", "check_out", "nuits_min", "annulation"] },
      { "type": "seller_card", "label": "Votre hôte" },
      { "type": "similar" },
      { "type": "cta_bar", "options": { "primary": "Vérifier les disponibilités", "show_price": true } }
    ],
    "card": { "primary_price": "semaine", "facts": ["capacite_max", "nb_chambres", "surface"], "badges": ["vue", "services_bien"] }
  },

  "validation": [
    { "id": "tarif_obligatoire", "severity": "error",
      "when": { "==": [{ "var": "pricing.filled_rates_count" }, 0] },
      "message": "Indiquez au moins un tarif (nuit, semaine ou mois). Une annonce sans prix reçoit 4× moins de demandes.", "field": "tarifs" },
    { "id": "coherence_semaine", "severity": "warning",
      "when": { ">": [{ "var": "pricing.rates.semaine" }, { "*": [{ "var": "pricing.rates.nuit" }, 7] }] },
      "message": "Votre tarif à la semaine est supérieur à 7 nuits au tarif unitaire : est-ce volontaire ?", "field": "tarifs" },
    { "id": "couchages_coherents", "severity": "warning",
      "when": { ">": [{ "var": "attributes.capacite_max" }, { "*": [{ "var": "attributes.nb_couchages" }, 1] }] },
      "message": "Le nombre de voyageurs dépasse le nombre de couchages déclarés.", "field": "capacite_max" },
    { "id": "photos_pieces", "severity": "warning",
      "when": { "<": [{ "var": "media.tagged_groups_count" }, 4] },
      "message": "Ajoutez au moins une photo par pièce principale (salon, cuisine, chambres, salle de bain).", "field": "photos" },
    { "id": "enregistrement_mairie", "severity": "error",
      "when": { "and": [{ "var": "city.requires_registration" }, { "!": { "var": "attributes.numero_enregistrement" } }] },
      "message": "Votre commune impose un numéro d'enregistrement pour les locations de courte durée.", "field": "numero_enregistrement" }
  ],

  "seo": {
    "url_pattern": "/immobilier/location-vacances/appartement/{city_slug}/{id}-{title_slug}",
    "schema_org": ["Apartment", "LodgingBusiness", "Offer"],
    "title_pattern": "Location vacances {ville} — Appartement {nb_chambres} ch.{vue_suffix} dès {price_from} | Deal&Co",
    "meta_description_pattern": "Louez cet appartement {nb_chambres} chambres pour {capacite_max} personnes à {ville}. {equipements_top}. À partir de {price_from}. Disponibilités en direct sur Deal&Co.",
    "h1_pattern": "Appartement {nb_chambres} chambres à {ville} — location de vacances",
    "breadcrumb": ["Accueil", "Immobilier", "Location de vacances", "{ville}", "{titre}"],
    "hub_pages": true
  },

  "classifier": {
    "head_nouns": ["appartement", "appart", "studio", "t1", "t2", "t3", "t4", "t5", "f1", "f2", "f3", "loft", "duplex", "logement"],
    "modifiers": ["vue mer", "piscine", "balcon", "terrasse", "climatisé", "centre-ville", "plage", "front de mer", "meublé"],
    "negative": ["utilitaire", "camion", "fourgon", "moteur", "kilométrage", "boîte automatique", "cheval fiscal"],
    "transaction_cues": {
      "location_saisonniere": ["vacances", "saisonnière", "saisonnier", "à la semaine", "semaine", "week-end", "nuit", "nuitée", "séjour", "juillet", "août", "été", "festival", "congrès", "courte durée", "airbnb", "meublé de tourisme"]
    },
    "prior": 1.0
  }
}
