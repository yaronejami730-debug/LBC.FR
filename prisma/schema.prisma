generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  password                String
  name                    String
  avatar                  String?
  verified                Boolean                   @default(false)
  memberSince             Int                       @default(2024)
  createdAt               DateTime                  @default(now())
  role                    String                    @default("USER")
  adminNote               String?
  participants            ConversationParticipant[]
  listings                Listing[]
  sentMessages            Message[]                 @relation("SentMessages")
  favorites               Favorite[]
  savedSearches           SavedSearch[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  isPro                   Boolean                   @default(false)
  siret                   String?                   @unique
  companyName             String?
  lastLoginAt             DateTime?
  reengagementSentAt      DateTime?
  earlyAdopterDiscount    Boolean                   @default(false)
  bannedAt                DateTime?
  banReason               String?
  restrictedAt            DateTime?
  banDecidedBy            String?
  /// Mise sous surveillance : le compte n'a rien fait qui justifie une
  /// sanction, mais il mérite d'être regardé. Aucun effet sur le compte —
  /// c'est un marque-page de modérateur, pas une punition.
  watchedAt               DateTime?
  watchReason             String?
  watchedBy               String?
  spamScore               Int                       @default(0)
  apiKeys                 ApiKey[]
  consentGivenAt          DateTime?
  marketingConsent        Boolean                   @default(false)
  notificationPreferences Json?
  civility                String?
  firstName               String?
  lastName                String?
  birthDate               DateTime?
  addressLine             String?
  addressCity             String?
  addressPostal           String?

  // Trust & safety
  trustScore           Int      @default(50)
  trustScoreUpdatedAt  DateTime @default(now())
  emailVerified        Boolean  @default(false)
  phoneNumber          String?  @unique
  phoneVerified        Boolean  @default(false)
  totalReportsAgainst  Int      @default(0)
  rejectedListingCount Int      @default(0)

  reportsMade      Report[]          @relation("ReportReporter")
  reportsAgainst   Report[]          @relation("ReportSubject")
  moderationEvents ModerationEvent[]
  deviceSessions   DeviceSession[]
  rateLimitBuckets RateLimitBucket[]
  externalSources  ExternalSource[]

  // Deal&Co Pet
  petProService PetProService?
  petBookings   PetBooking[]   @relation("PetBookingClient")
  petReviews    PetReview[]    @relation("PetReviewAuthor")

  // Moteur comportemental
  draft             Draft?
  pushSubscriptions PushSubscription[]
  expoPushTokens    ExpoPushToken[]

  // Vérification des comptes professionnels
  //
  // `isPro` dit ce que le compte *est* aujourd'hui ; `professionalStatus` dit
  // où en est son habilitation. Les deux existent parce qu'un compte peut être
  // particulier avec un dossier en cours (PENDING) sans rien perdre, ou
  // professionnel suspendu sans être rétrogradé.
  /// NONE | PENDING | APPROVED | REJECTED | SUSPENDED | INFO_REQUESTED
  professionalStatus String            @default("NONE")
  /// Badge de vérification : demandé par l'utilisateur, accordé après délai.
  /// `verified` reste le drapeau d'affichage ; ces dates disent où l'on en est.
  badgeRequestedAt   DateTime?
  badgeGrantedAt     DateTime?
  proVerifiedAt      DateTime?
  /// Établissements créés par ce compte. Ce n'est plus le vecteur des droits —
  /// voir `proAccess` — mais la trace du créateur.
  proProfiles        ProProfile[]
  /// Entreprises que ce compte administre, avec son rôle sur chacune.
  proAccess          ProAccess[]
  proBookings        ProBooking[]      @relation("ProBookingCustomer")
  subscriptions      Subscription[]    @relation("SubscriptionFollower")
  subscribers        Subscription[]    @relation("SubscriptionSeller")
  /// Lignes d'équipe rattachées à ce compte : « je suis aussi coiffeuse chez
  /// Joana ». Donne accès à l'agenda du salon, à rien d'autre.
  proMemberships     ProMember[]       @relation("ProMemberAccount")
  proVerifications   ProVerification[] @relation("ProVerificationUser")
  proReviews         ProVerification[] @relation("ProVerificationReviewer")

  // Moteur de recommandation locale
  locationProfiles UserLocationProfile[]
  categoryInterests UserCategoryInterest[]
  recommendations  ListingRecommendationLog[]

  @@index([watchedAt])
  @@index([bannedAt])
}

/// Abonnement d'un utilisateur aux publications d'un vendeur.
///
/// Gratuit et sans réciprocité, comme un abonnement à une chaîne : A suit B,
/// B n'a rien à accepter. `lastNotifiedAt` retient jusqu'où l'abonné a été
/// prévenu — c'est ce qui permet de regrouper plusieurs annonces publiées à la
/// chaîne dans un seul email au lieu d'en envoyer un par annonce.
model Subscription {
  id         String @id @default(cuid())
  followerId String
  sellerId   String
  follower   User   @relation("SubscriptionFollower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User   @relation("SubscriptionSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?
  /// Coupe les emails sans se désabonner.
  emailEnabled   Boolean   @default(true)

  @@unique([followerId, sellerId])
  @@index([sellerId])
  @@index([followerId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EarlyAdopter {
  id               String    @id @default(cuid())
  companyName      String
  siret            String?
  managerFirstName String
  email            String    @unique
  registeredAt     DateTime  @default(now())
  claimedAt        DateTime?
  userId           String?
}

model Waitlist {
  id              String   @id @default(cuid())
  email           String
  citySlug        String?
  categoryId      String?
  subcategorySlug String?
  /// Demande exprimée en toutes lettres — « peugeot 308 », « iphone 14 ».
  ///
  /// Une inscription depuis une page de cote (`/prix/*`) ne se range dans
  /// aucune catégorie ni aucune ville : c'est un modèle précis que le visiteur
  /// cherche et que l'inventaire n'a pas. C'est précisément le signal qui
  /// intéresse le recrutement vendeurs, et il n'avait nulle part où être écrit.
  query           String?
  source          String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@unique([email, categoryId, citySlug, subcategorySlug])
  @@index([email])
  @@index([categoryId])
  @@index([citySlug])
  @@index([query])
}

model Listing {
  id                  String      @id @default(cuid())
  title               String
  description         String
  price               Float
  category            String
  subcategory         String?
  location            String
  /**
   * État de l'objet. Nullable : une prestation, une offre d'emploi ou un
   * événement n'en ont pas. Le défaut « Good » remplissait la colonne pour
   * tout le monde et faisait remonter des manucures dans les filtres « Neuf ».
   * Voir lib/offer-intent.ts.
   */
  condition           String?
  brand               String?
  material            String?
  images              String      @default("[]")
  isPremium           Boolean     @default(false)
  isVerified          Boolean     @default(false)
  userId              String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?
  metadata            String      @default("{}")
  vehicleKm           Int?
  vehicleYear         Int?
  immoSurface         Float?
  immoRooms           Int?
  phone               String?
  phoneHash           String?
  hidePhone           Boolean     @default(false)
  /// PARTICULIER | PRO — sous quelle casquette l'annonce est publiée.
  ///
  /// Un compte converti du particulier au professionnel garde les deux usages :
  /// il vend son canapé le samedi et son stock la semaine. Le choix est fait à
  /// la publication, pas déduit du compte, parce que les deux ne suivent pas
  /// les mêmes règles — notamment sur la précision de l'adresse affichée.
  postedAs            String      @default("PARTICULIER")
  /// Adresse précise, réservée aux annonces professionnelles : un local
  /// commercial est une adresse publique, le domicile d'un particulier non.
  addressLine         String?
  /// Établissement qui publie l'annonce. Nul pour un particulier.
  ///
  /// Indispensable dès qu'un compte porte plusieurs boutiques : « BMW Série 3 »
  /// appartient à Simplifica Versailles, pas au compte Simplifica en général,
  /// et c'est le téléphone et l'adresse de Versailles qu'il faut afficher.
  /// Tant que la relation compte → établissement était bijective on pouvait la
  /// déduire ; avec trois établissements, la déduction devient impossible.
  establishmentId     String?
  establishment       ProProfile? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  /// APPROVED | PENDING | UNDER_REVIEW | REJECTED | REMOVED | SOLD
  ///
  /// REMOVED = retirée par la modération. Invisible publiquement (toutes les
  /// requêtes publiques filtrent sur APPROVED), mais toujours accessible à son
  /// auteur depuis son espace personnel pendant le délai de conservation.
  ///
  /// UNDER_REVIEW = mise en revue. Également invisible, mais ce n'est pas une
  /// sanction : aucun compte à rebours de suppression ne court. On demande une
  /// correction précise (« votre titre est identique à celui d'une autre de vos
  /// annonces »), et l'annonce repart en modération dès qu'elle est modifiée.
  status              String      @default("APPROVED")
  rejectionReason     String?
  adminNote           String?
  /// Retrait de modération : date du retrait et date de destruction définitive.
  /// `permanentDeletionAt` n'est jamais repoussé quand l'annonce est refusée à
  /// nouveau — sinon une annonce refusée en boucle ne serait jamais purgée.
  removedAt           DateTime?
  /// Date de la dernière mise en revue. Sans effet sur la purge : une annonce
  /// en revue n'est pas en sursis, elle attend une correction.
  reviewRequestedAt   DateTime?
  permanentDeletionAt DateTime?
  expiresAt           DateTime?
  expiryNotifiedAt    DateTime?
  photoReminderSentAt DateTime?
  viewCount           Int         @default(0)
  phoneClickCount     Int         @default(0)
  messageClickCount   Int         @default(0)
  interestNotifiedAt  DateTime?
  shadowBanned        Boolean     @default(false)
  reviewPriority      Int         @default(0)

  // Trust & safety
  qualityScore          Int      @default(50)
  qualityScoreUpdatedAt DateTime @default(now())
  reportCount           Int      @default(0)
  imageDupCount         Int      @default(0)
  ipAtCreate            String?
  uaAtCreate            String?
  flagsJson             String   @default("[]")

  // Risk engine — empreinte SimHash (hex 16 car.) + bandes LSH + score de risque
  simhash      String?
  lshBand0     Int?
  lshBand1     Int?
  lshBand2     Int?
  lshBand3     Int?
  riskScore    Int     @default(0)
  riskDecision String?

  // Géolocalisation résolue depuis `location` (lib/geo/communes.ts).
  //
  // `location` est une chaîne saisie à la main : elle sert à l'affichage et à
  // la recherche textuelle, jamais au calcul de distance. Comparer « Paris » et
  // « Levallois-Perret » ne dit rien ; comparer deux couples lat/lng dit tout.
  // Les colonnes sont dénormalisées sur l'annonce plutôt que recalculées à la
  // volée : un envoi qui géocode 10 000 annonces à chaque exécution du CRON est
  // un envoi qui expire.
  geoLat       Float?
  geoLng       Float?
  /// COMMUNE | POSTAL | DEPARTMENT — finesse du point. Un point départemental
  /// ne permet pas de statuer à 20 km près et est écarté des recommandations.
  geoPrecision String?
  geoCity      String?
  geoInsee     String?
  geoResolvedAt DateTime?

  conversations    Conversation[]
  user             User              @relation(fields: [userId], references: [id])
  favorites        Favorite[]
  listingImages    ListingImage[]
  reports          Report[]
  moderationEvents ModerationEvent[]
  recommendations  ListingRecommendationLog[]

  @@index([geoLat, geoLng])
  @@index([status, deletedAt, shadowBanned, geoResolvedAt])
  @@index([status, deletedAt, shadowBanned])
  @@index([status, deletedAt, shadowBanned, createdAt])
  @@index([status, deletedAt, shadowBanned, category])
  @@index([status, deletedAt, shadowBanned, category, subcategory, location])
  @@index([qualityScore])
  @@index([status, permanentDeletionAt])
  @@index([postedAs])
  @@index([lshBand0])
  @@index([lshBand1])
  @@index([lshBand2])
  @@index([lshBand3])
  @@index([phoneHash])
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  phash        BigInt?
  lshBand0     Int?
  lshBand1     Int?
  lshBand2     Int?
  lshBand3     Int?
  width        Int?
  height       Int?
  sizeBytes    Int?
  blurVar      Float?
  isScreenshot Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([phash])
  @@index([lshBand0])
  @@index([lshBand1])
  @@index([lshBand2])
  @@index([lshBand3])
  @@index([listingId])
}

model Report {
  id         String    @id @default(cuid())
  listingId  String?
  userId     String?
  reporterId String
  category   String // scam, spam, illegal, offensive, fake, wrong_category, duplicate, personal_data, stolen_photos, other
  message    String?
  status     String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  reporter User     @relation("ReportReporter", fields: [reporterId], references: [id])
  subject  User?    @relation("ReportSubject", fields: [userId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])

  @@index([listingId, status])
  @@index([userId, status])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model ModerationEvent {
  id          String   @id @default(cuid())
  listingId   String?
  userId      String?
  actor       String // "system", "admin:{id}", "cron:{name}"
  action      String // auto_approve, auto_pending, auto_shadow, auto_reject, admin_approve, report_flagged, rate_limit_hit, etc
  reason      String
  flagsJson   String   @default("[]")
  scoreBefore Int?
  scoreAfter  Int?
  createdAt   DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model DeviceSession {
  id          String   @id @default(cuid())
  userId      String
  ipHash      String
  uaHash      String
  fingerprint String?
  /// Libellé lisible dérivé du User-Agent (« Chrome sur macOS »). Le
  /// User-Agent brut n'est pas conservé.
  deviceName  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([ipHash])
  @@index([fingerprint])
  @@index([userId])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  userId      String?
  ipHash      String?
  bucket      String // listing_create, message_send, image_upload, report_submit, signup
  count       Int      @default(1)
  windowStart DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([userId, bucket, windowStart])
  @@index([ipHash, bucket])
  @@index([userId, bucket])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  listing      Listing                   @relation(fields: [listingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderId       String
  conversationId String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  riskScore      Int          @default(0)
  flagged        Boolean      @default(false)
  flagReason     String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([flagged, createdAt])
}

model ExternalSource {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label        String // nom public affiché sur les annonces importées
  kind         String    @default("auto") // bsk | auto | (futurs connecteurs)
  url          String // URL complète saisie (= base_url scrapée)
  domain       String? // hostname extrait (sans www) — ex. bskimmobilier.com
  agencySlug   String? // premier segment de path — ex. paris-17 ou sylvie-mekil-8374
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  lastResult   String? // JSON: { created, deduped, failed, total, details[] }
  createdAt    DateTime  @default(now())

  @@index([ownerId])
  @@index([domain, agencySlug])
}

model Blacklist {
  kind    String // domain | email_domain | phone | ip
  value   String
  reason  String?
  source  String? // ex. "discord-antiscam", "manual"
  addedAt DateTime @default(now())

  @@id([kind, value])
  @@index([kind])
}

/// Registre anti-réinscription.
///
/// Quand un compte banni est détruit, ses données personnelles disparaissent —
/// mais pas la décision de bannissement, sinon il suffirait de se réinscrire
/// avec la même adresse. Cette table ne contient donc *aucune* donnée en
/// clair : uniquement des empreintes non réversibles, calculées après
/// normalisation, et le strict nécessaire pour justifier le blocage.
///
/// Un email seul se remplace en trente secondes : le registre garde aussi le
/// téléphone et le SIRET, plus difficiles à renouveler, et l'empreinte
/// d'appareil connue au moment du bannissement.
model BanRegistry {
  id           String    @id @default(cuid())
  /// sha256(pepper + valeur normalisée). Aucune valeur en clair.
  emailHash    String?   @unique
  phoneHash    String?
  siretHash    String?
  deviceHashes String    @default("[]")
  banReason    String
  bannedAt     DateTime  @default(now())
  /// Renseigné quand le compte d'origine a été détruit — sert au journal
  /// d'audit, jamais à retrouver la personne.
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([phoneHash])
  @@index([siretHash])
}

/// Journal des actions d'administration irréversibles.
///
/// Volontairement pauvre en données : une suppression définitive doit laisser
/// une trace vérifiable (qui, quoi, combien, quand) sans réintroduire les
/// données qu'elle vient justement d'effacer.
model AdminAuditLog {
  id          String   @id @default(cuid())
  action      String // PERMANENT_DELETE_BANNED_ACCOUNTS, PERMANENT_DELETE_LISTING, WATCH_ACCOUNT…
  adminId     String
  adminName   String?
  targetType  String? // "user" | "listing"
  targetId    String?
  count       Int      @default(1)
  reason      String?
  detailsJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

model SavedSearch {
  id             String   @id @default(cuid())
  userId         String
  name           String
  filters        String   @default("{}") // JSON: { category, q, minPrice, maxPrice, location, ... }
  lastNotifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HeroBanner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  bgFrom    String    @default("#2f6fb8")
  bgTo      String    @default("#1a5a9e")
  bgImage   String?
  textColor String    @default("#ffffff")
  /// Si false ET bgImage présent : photo seule, sans titre/sous-titre/CTA.
  showText  Boolean   @default(true)
  isActive  Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model CategorySetting {
  id           String   @id @default(cuid())
  categoryId   String   @unique
  approvalMode String   @default("AUTO") // "AUTO" | "MANUAL"
  updatedAt    DateTime @updatedAt
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  createdAt DateTime @default(now())
}

model Advertisement {
  id              String    @id @default(cuid())
  title           String
  description     String
  imageUrl        String
  imageUrlWide    String?
  destinationUrl  String
  isActive        Boolean   @default(true)
  clicks          Int       @default(0)
  impressions     Int       @default(0)
  // Impressions par emplacement
  impCarousel     Int       @default(0) // Bannière accueil
  impRotator      Int       @default(0) // Encart page annonce
  impGrid         Int       @default(0) // Fil de résultats
  impInterstitial Int       @default(0) // Plein écran modal
  /// Si vrai : affichée en plein écran (interstitielle) à l'ouverture de l'app.
  isInterstitial  Boolean   @default(false)
  scheduledAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model SeoPageContent {
  id              String   @id @default(cuid())
  pageKey         String   @unique
  categoryId      String
  subcategorySlug String?
  citySlug        String?
  metaTitle       String
  metaDescription String
  h1              String
  intro           String
  localTips       String?
  faq             String   @default("[]")
  keywords        String   @default("[]")
  model           String   @default("claude")
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([citySlug])
  @@index([categoryId, citySlug])
}

// ─────────────────────────────────────────────────────────────────────────────
// Deal&Co Pet — paid pet-services matching (separate universe, 10% commission)
// ─────────────────────────────────────────────────────────────────────────────

model PetProService {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  slug        String  @unique
  bio         String
  city        String
  postalCode  String?
  photos      String  @default("[]")

  stripeAccountId      String?   @unique
  stripeChargesEnabled Boolean   @default(false)
  stripePayoutsEnabled Boolean   @default(false)
  kycCompletedAt       DateTime?

  isPublished Boolean @default(false)
  isVerified  Boolean @default(false)
  avgRating   Float?
  reviewCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings PetServiceOffering[]
  bookings  PetBooking[]
  reviews   PetReview[]

  @@index([city])
  @@index([isPublished, kycCompletedAt])
}

model PetServiceOffering {
  id           String        @id @default(cuid())
  proServiceId String
  proService   PetProService @relation(fields: [proServiceId], references: [id], onDelete: Cascade)

  serviceType String // GARDE_DOMICILE | GARDE_CHEZ_PRO | PROMENADE
  title       String
  description String
  priceCents  Int
  unit        String  @default("DAY") // DAY | HOUR
  petTypes    String  @default("[\"DOG\"]")
  maxPets     Int     @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings PetBooking[]

  @@index([proServiceId, isActive])
  @@index([serviceType])
}

model PetBooking {
  id String @id @default(cuid())

  proServiceId String
  proService   PetProService @relation(fields: [proServiceId], references: [id])

  offeringId String
  offering   PetServiceOffering @relation(fields: [offeringId], references: [id])

  clientId String
  client   User   @relation("PetBookingClient", fields: [clientId], references: [id])

  startDate DateTime
  endDate   DateTime
  petCount  Int      @default(1)
  petInfo   String?

  totalCents       Int
  platformFeeCents Int
  proPayoutCents   Int

  // PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED | REFUNDED
  status String @default("PENDING")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  cancelReason String?

  payment PetPayment?
  review  PetReview?

  @@index([clientId])
  @@index([proServiceId, status])
  @@index([status, endDate])
}

model PetPayment {
  id        String     @id @default(cuid())
  bookingId String     @unique
  booking   PetBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String  @unique
  stripeChargeId        String?
  stripeTransferId      String?
  stripeRefundId        String?

  amountCents      Int
  platformFeeCents Int
  currency         String @default("eur")

  // REQUIRES_PAYMENT | SUCCEEDED | HELD | RELEASED | REFUNDED | FAILED
  status String @default("REQUIRES_PAYMENT")

  capturedAt DateTime?
  releasedAt DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PetReview {
  id        String     @id @default(cuid())
  bookingId String     @unique
  booking   PetBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  proServiceId String
  proService   PetProService @relation(fields: [proServiceId], references: [id])

  authorId String
  author   User   @relation("PetReviewAuthor", fields: [authorId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([proServiceId])
}

// Instantané SEO — capture quotidienne des données Google Search Console.
// Sert de mémoire à l'IA SEO : comparer les snapshots dans le temps fait
// ressortir les tendances de recherche, les mots-clés émergents et la
// dérive de position. Les détails (requêtes, pages, mots-clés) sont stockés
// en JSON sérialisé, comme `ModerationEvent.flagsJson`.
model SeoSnapshot {
  id             String   @id @default(cuid())
  // Fenêtre d'analyse réellement interrogée (latence Search Console ~3 j).
  startDate      String
  endDate        String
  // Agrégats globaux sur la fenêtre.
  clicks         Int      @default(0)
  impressions    Int      @default(0)
  ctr            Float    @default(0)
  position       Float    @default(0)
  // Données détaillées sérialisées (tableaux JSON).
  topQueriesJson String   @default("[]")
  topPagesJson   String   @default("[]")
  emergingJson   String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// Brouillon de publication — alimente le moteur anti-friction.
/// Un brouillon dont `updatedAt` traîne sans annonce publiée derrière =
/// formulaire abandonné = signal de friction le plus fort. Un seul brouillon
/// actif par utilisateur (upsert sur `userId`).
model Draft {
  id           String   @id @default(cuid())
  userId       String   @unique
  payload      String // instantané JSON du formulaire
  category     String?
  step         Int      @default(0) // étape de l'assistant atteinte
  completeness Int      @default(0) // 0–100 — % de champs requis remplis
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// Événement d'email — envoi / ouverture / clic. Alimente le moteur
/// comportemental : choix du canal et du timing (heures d'ouverture réelles).
/// Pas de FK vers User (userId simple colonne) : les events survivent à la
/// suppression du compte pour l'analyse agrégée.
model EmailEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  emailType String   @default("transactional")
  kind      String // "sent" | "open" | "click"
  url       String? // destination, pour kind = "click"
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([emailType, kind])
  @@index([createdAt])
}

/// Journal d'événements utilisateur — base de l'analyse intention/hésitation
/// du moteur comportemental (page_view, form_step, listing_view, search…).
/// `meta` est un objet JSON sérialisé, le schéma reste libre par kind.
model UserEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  kind      String
  path      String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([kind, createdAt])
  @@index([sessionId, createdAt])
}

/// Abonnement Web Push d'un appareil (un user peut en avoir plusieurs).
/// Endpoint = identifiant unique (URL push du navigateur). p256dh + auth
/// sont les clés cryptographiques de la souscription (RFC 8291). Disabled
/// quand l'envoi a échoué de manière permanente (410 Gone, 404).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  disabledAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

/// Jeton Expo Push pour les apps mobiles (iOS/Android via Expo).
/// Le token est l'identifiant unique délivré par Expo (ExponentPushToken[…]).
/// Désactivé quand Expo renvoie DeviceNotRegistered ou InvalidCredentials.
model ExpoPushToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String?
  deviceName String?
  appVersion String?
  /// Mode dans lequel l'appareil est actuellement utilisé : `user` ou `admin`.
  ///
  /// Un administrateur reste un utilisateur ordinaire : il vend, il achète, il
  /// reçoit des messages. Quand il bascule son application en mode
  /// administrateur, ce ne sont plus les mêmes alertes qui l'intéressent — une
  /// annonce en attente, un signalement — et surtout plus les mêmes qu'il veut
  /// recevoir la nuit. Le mode est porté par l'appareil et non par le compte :
  /// le téléphone peut être en mode administrateur pendant que la tablette
  /// reste en mode utilisateur.
  mode       String    @default("user")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  disabledAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
  @@index([mode, disabledAt])
}

/// Demande de contact d'un annonceur potentiel, déposée depuis la page
/// d'accueil. Le prospect ne crée pas de compte : on collecte le strict
/// nécessaire pour rappeler sous 24-48 h. Le suivi commercial se fait dans
/// l'admin (statut + notes), jamais côté public.
model AdvertiserLead {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String
  /// Budget publicitaire annoncé, en libellé de tranche (ex. "1000-5000").
  budget      String
  company     String?
  message     String?
  /// NEW | CONTACTED | QUALIFIED | WON | LOST
  status      String    @default("NEW")
  /// Page ou campagne d'origine, pour mesurer ce qui convertit.
  source      String?
  userAgent   String?
  ip          String?
  /// Notes internes de l'équipe commerciale.
  notes       String?
  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// Dossier de vérification d'un compte professionnel.
///
/// Un SIRET valide ne prouve rien : il est public, n'importe qui peut recopier
/// celui d'une autre entreprise. Le passage en compte pro exige donc une pièce
/// d'identité et un justificatif d'entreprise (Kbis ou avis de situation
/// SIRENE), relus par un modérateur — même logique que la validation des
/// annonces.
///
/// Les documents ne sont pas stockés en accès public : seul le `pathname` du
/// blob privé est conservé, et l'admin les consulte via une route qui vérifie
/// son rôle.
model ProVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ProVerificationUser", fields: [userId], references: [id], onDelete: Cascade)

  /// PENDING | APPROVED | REJECTED | SUSPENDED | INFO_REQUESTED
  status      String @default("PENDING")
  /// DIRECT_PROFESSIONAL (inscription pro) | CONVERT_FROM_PRIVATE (conversion)
  requestType String @default("CONVERT_FROM_PRIVATE")

  siret                 String
  /// Ce SIRET a déjà servi à un compte banni.
  ///
  /// Ce n'est pas une charge contre le demandeur — c'est souvent l'inverse. Un
  /// SIRET est public : celui d'Apple ou de Sony se recopie en trois secondes.
  /// Le compte qui arrive ensuite avec ce numéro est le plus souvent
  /// l'entreprise réelle, la seule capable de fournir le Kbis correspondant.
  /// Le drapeau sert à faire examiner le dossier avec attention, jamais à le
  /// refuser d'office.
  siretPreviouslyBanned Boolean @default(false)
  siren                 String?
  companyName           String
  commercialName        String?
  businessAddress       String?
  businessActivity      String?
  businessCategory      String?

  responsibleFirstName String?
  responsibleLastName  String?
  professionalPhone    String?
  professionalEmail    String?

  /// Type de pièce fournie : CNI | PASSEPORT | TITRE_SEJOUR
  idDocumentType     String
  idDocumentPath     String
  /// Verso de la pièce (CNI, titre de séjour) — absent pour un passeport.
  idDocumentBackPath String?
  /// Type de justificatif : KBIS | AVIS_SIRENE
  companyDocType     String
  companyDocPath     String

  submittedAt DateTime @default(now())

  /// Conservé pour compatibilité : miroir de approvedAt/rejectedAt.
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ProVerificationReviewer", fields: [reviewedById], references: [id])
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectedById    String?
  suspendedAt     DateTime?
  suspendedById   String?
  rejectionReason String?
  /// Demande d'information adressée au professionnel, en clair.
  infoRequest     String?
  adminNote       String?

  logs ProVerificationLog[]

  @@index([status, submittedAt])
  @@index([userId])
}

/// Historique immuable des décisions de modération professionnelle.
///
/// Aucune ligne n'est modifiée ni supprimée : une décision d'habilitation doit
/// pouvoir être reconstituée des mois plus tard, y compris si le dossier a
/// changé de statut entre-temps.
model ProVerificationLog {
  id             String          @id @default(cuid())
  verificationId String
  verification   ProVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  /// SUBMITTED | OPENED | INFO_REQUESTED | DOCUMENT_ADDED | UPDATED | APPROVED | REJECTED | SUSPENDED | REINSTATED
  action  String
  /// Auteur : "user:{id}" ou "admin:{id}".
  actor   String
  details String?

  createdAt DateTime @default(now())

  @@index([verificationId, createdAt])
}

/// Espace professionnel : un établissement, une fiche, une carte de prestations.
///
/// Un salon ne doit pas publier trente annonces pour présenter trente
/// prestations. Il crée un espace, y range sa carte, et ses annonces renvoient
/// dessus. Réservé aux comptes professionnels vérifiés (cf. ProVerification) :
/// c'est ce qui distingue une fiche d'établissement d'une petite annonce.
/// L'entreprise — la personne morale, pas le lieu.
///
/// Une même société porte un ou plusieurs établissements : « SARL Beauty
/// Group » exploite le Salon Paris 17e, le Salon Neuilly et le Salon
/// Levallois. Sans ce niveau, chaque nouvelle boutique demanderait un compte
/// et une adresse email de plus.
///
/// `User.siret` et `User.companyName` restent en place : la vérification
/// professionnelle, le registre anti-réinscription et la détection de fraude
/// s'appuient dessus. Ici, c'est la source de vérité de ce qui est *affiché* et
/// facturé ; là-bas, celle de l'habilitation.
model ProCompany {
  id String @id @default(cuid())

  /// Raison sociale — « SARL Dupont ».
  legalName String
  /// Nom commercial du groupe, quand il diffère — « Beauty Group ».
  tradeName String?
  siret     String?
  /// SARL, SAS, auto-entrepreneur…
  legalForm String?
  vatNumber String?

  billingEmail   String?
  billingAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  establishments ProProfile[]
  access         ProAccess[]

  @@index([siret])
}

/// Qui a le droit d'administrer quoi.
///
/// ⚠️ À ne pas confondre avec `ProMember`, qui est la personne qu'on *planifie*
/// (Corinne, souvent sans compte Deal&Co). `ProAccess` est le compte qui
/// *administre*. Une même personne peut être propriétaire de sa société et
/// salariée d'une autre : ce sont alors deux lignes, sans cas particulier.
model ProAccess {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   ProCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// OWNER   toute l'entreprise, légal et facturation compris
  /// ADMIN   toute l'entreprise, sauf légal et facturation
  /// MANAGER restreint aux établissements listés dans `establishmentIds`
  role String @default("OWNER")

  /// Périmètre d'un MANAGER (JSON, ids d'établissements). Vide pour OWNER et
  /// ADMIN, dont la portée est l'entreprise entière.
  establishmentIds String @default("[]")

  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId, role])
}

/// L'établissement : le lieu que le client voit, avec son adresse, son équipe
/// et son agenda. Le nom du modèle dit « profil » pour des raisons
/// historiques — c'est bien un point de vente.
model ProProfile {
  id     String @id @default(cuid())
  /// Créateur de la fiche. N'est plus l'autorité : les droits passent par
  /// `ProAccess`. Conservé parce que les fiches d'avant le multi-établissement
  /// n'ont pas d'autre trace de leur propriétaire.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nullable le temps du remplissage, puis obligatoire.
  companyId String?
  company   ProCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Nom commercial affiché — « Barber Turbigo », « Beauty Studio Paris 3 ».
  name        String
  slug        String  @unique
  /// Identifiants de catégories couvertes (JSON), ex. ["beaute-bien-etre"].
  categories  String  @default("[]")
  description String?

  addressLine String?
  city        String?
  postalCode  String?
  phone       String?
  website     String?

  /// Cadrage de la couverture, façon Facebook : la photo est rarement cadrée
  /// pour un bandeau très large, et sans réglage la devanture se retrouve
  /// coupée. `coverX`/`coverY` sont exprimés en pourcentage (0-100) et
  /// alimentent `object-position` ; `coverZoom` échelonne l'image.
  coverX    Float @default(50)
  coverY    Float @default(50)
  coverZoom Float @default(1)

  /// Horaires par jour (JSON) : { "lundi": "09:00-19:00", … }
  hours      String  @default("{}")
  /// Photos de l'établissement (JSON, URLs).
  photos     String  @default("[]")
  coverImage String?

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Métier déclaré — un id de domaine du catalogue `data/pro-catalog`
  /// (`beaute`, `automobile`, `loisirs`…). Détermine les capacités par défaut
  /// et le vocabulaire de l'interface. Porté par l'établissement et non par
  /// l'entreprise : un groupe peut exploiter un salon *et* un garage.
  activityType String?
  /// Capacités effectives (JSON), initialisées depuis le métier puis
  /// modifiables : ["listings","offerings","services","activities","staff","bookings"].
  capabilities String  @default("[]")

  services        ProService[]
  members         ProMember[]
  memberLinks     ProMemberEstablishment[]
  workingHours    ProWorkingHours[]
  breaks          ProBreak[]
  listings        Listing[]
  bookings        ProBooking[]
  bookingSettings ProBookingSettings?

  @@index([isPublished, city])
}

/// Une ligne de la carte : « Massage relaxant · 60 min · 60 € ».
model ProService {
  id        String     @id @default(cuid())
  profileId String
  profile   ProProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Rubrique de la carte : « Massages », « Coiffure », « Barbe »…
  section     String
  label       String
  durationMin Int?
  price       Float
  /// Mention libre : « +5 € », « à partir de », « sur devis ».
  priceNote   String?
  position    Int     @default(0)

  /// Retirée de la carte sans être supprimée — les réservations passées
  /// gardent leur référence.
  isActive   Boolean @default(true)
  /// Réservable en ligne. Une ligne « sur devis » reste affichée mais ne
  /// produit aucun créneau : sans `durationMin`, le moteur ne sait pas
  /// combien de temps bloquer.
  isBookable Boolean @default(true)

  members  ProMemberService[]
  bookings ProBooking[]

  @@index([profileId, position])
}

/// Un membre de l'équipe : « Corinne », « Nathalie ».
///
/// Ce n'est pas un `User`. Une coiffeuse n'a pas forcément de compte Deal&Co,
/// et le salon doit pouvoir gérer son planning dès le premier jour. Le jour où
/// elle en veut un, on ajoutera un `userId` optionnel — pas avant.
model ProMember {
  id        String     @id @default(cuid())
  profileId String
  profile   ProProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// État civil, interne au salon. Deux Nathalie se distinguent ici.
  firstName   String?
  lastName    String?
  /// Libellé public, dérivé du prénom : « Corinne », ou « Corinne D. » s'il
  /// faut lever une ambiguïté. Le nom complet n'a rien à faire sur une page
  /// indexée — un salarié n'a pas choisi d'être référencé.
  displayName String
  /// Intitulé affiché sous le nom : « Coloriste », « Barbier ».
  role        String?
  avatar      String?

  // ── Accès personnel au planning ──────────────────────────────────────
  //
  // Un membre d'équipe n'est pas un `User` : il n'a ni annonces, ni favoris,
  // ni fiche. Il a seulement besoin de voir les rendez-vous qui lui sont
  // attribués. D'où des identifiants portés par la ligne d'équipe, générés par
  // la responsable — le salarié ne s'inscrit pas, on lui remet un accès.
  //
  // S'il veut vendre ses affaires personnelles, il se crée un compte Deal&Co
  // ordinaire, sans rapport avec le salon.
  /// Compte Deal&Co personnel de cette personne, quand elle en a créé un avec
  /// la même adresse. Purement informatif du côté du salon : il sert à afficher
  /// l'agenda du salon dans l'espace personnel, et jamais l'inverse — un membre
  /// d'équipe ne devient pas administrateur de la fiche.
  userId             String?
  user               User?     @relation("ProMemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  /// Adresse où le salon envoie les accès. Facultative : un identifiant peut
  /// très bien se transmettre de vive voix. Elle sert à (re)envoyer les accès
  /// sans avoir à la redemander.
  email              String?
  /// Identifiant de connexion généré, ex. « corinne-4821 ».
  loginId            String?   @unique
  passwordHash       String?
  /// Mot de passe remis en clair : à changer à la première connexion.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  /// Accès coupé sans supprimer le membre — l'historique des rendez-vous reste.
  accessRevokedAt    DateTime?
  /// Couleur de la pastille dans l'agenda (hex).
  color              String    @default("#2f6fb8")
  isActive           Boolean   @default(true)
  position           Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       ProMemberService[]
  establishments ProMemberEstablishment[]
  workingHours   ProWorkingHours[]
  breaks         ProBreak[]
  timeOff        ProTimeOff[]
  bookings       ProBooking[]

  @@index([profileId, isActive, position])
}

/// Les établissements où travaille un membre.
///
/// Nathalie officie à Paris et à Neuilly. Il serait tentant de la dupliquer,
/// un `ProMember` par salon — c'est un piège : la contrainte d'exclusion
/// PostgreSQL porte sur `memberId`, donc deux lignes distinctes la laisseraient
/// être réservée à 14h00 dans les deux salons à la fois. Un seul membre,
/// rattaché à plusieurs établissements, garde la garantie intacte.
model ProMemberEstablishment {
  id        String     @id @default(cuid())
  memberId  String
  member    ProMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  profileId String
  profile   ProProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([memberId, profileId])
  @@index([profileId])
}

/// Qui sait faire quoi. Sans cette ligne, le membre n'est jamais proposé pour
/// la prestation — c'est ce qui alimente l'étape 2 du parcours client.
model ProMemberService {
  id        String     @id @default(cuid())
  memberId  String
  member    ProMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId String
  service   ProService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([memberId, serviceId])
  @@index([serviceId])
}

/// Horaires de travail récurrents, par membre et par jour de semaine.
///
/// Les minutes depuis minuit, pas des chaînes « 09:00 ». `ProProfile.hours`
/// reste le texte affiché sur la fiche ; ici c'est ce que le moteur calcule.
/// Deux plages le même jour = deux lignes (matin, après-midi).
model ProWorkingHours {
  id       String    @id @default(cuid())
  memberId String
  member   ProMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Établissement concerné. Nathalie peut être lundi-mercredi à Paris et
  /// jeudi-vendredi à Neuilly : sans cette colonne, ses horaires seraient les
  /// mêmes partout. Nullable le temps du remplissage.
  profileId String?
  profile   ProProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// 0 = dimanche … 6 = samedi (aligné sur `Date.getDay()`).
  weekday  Int
  startMin Int
  endMin   Int

  @@index([memberId, weekday])
  @@index([profileId, weekday])
}

/// Pause récurrente : la coupure déjeuner, typiquement.
model ProBreak {
  id       String    @id @default(cuid())
  memberId String
  member   ProMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Même raison que pour les horaires : la coupure déjeuner d'un salon n'est
  /// pas celle de l'autre.
  profileId String?
  profile   ProProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  weekday  Int
  startMin Int
  endMin   Int
  label    String?

  @@index([memberId, weekday])
  @@index([profileId, weekday])
}

/// Absence ponctuelle : congés, formation, rendez-vous personnel.
/// Datée, contrairement à `ProBreak` qui se répète chaque semaine.
model ProTimeOff {
  id       String    @id @default(cuid())
  memberId String
  member   ProMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  reason  String?

  createdAt DateTime @default(now())

  @@index([memberId, startAt, endAt])
}

/// Un rendez-vous.
///
/// `priceSnapshot` / `durationSnapshot` figent la prestation au moment de la
/// réservation : le salon qui augmente ses tarifs demain ne doit pas réécrire
/// le prix d'un rendez-vous déjà pris.
///
/// Le client peut ne pas avoir de compte — d'où `customerId` optionnel et les
/// coordonnées stockées en clair sur la ligne.
model ProBooking {
  id        String     @id @default(cuid())
  profileId String
  profile   ProProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  memberId String
  member   ProMember @relation(fields: [memberId], references: [id])

  serviceId String
  service   ProService @relation(fields: [serviceId], references: [id])

  customerId String?
  customer   User?   @relation("ProBookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  startAt DateTime
  endAt   DateTime

  firstName String
  lastName  String
  phone     String
  email     String
  note      String?

  priceSnapshot    Float
  durationSnapshot Int
  /// Libellé figé, pour que l'historique reste lisible si la ligne de carte
  /// est renommée ou supprimée.
  labelSnapshot    String

  /// D'où vient le rendez-vous.
  ///
  /// ONLINE  le client a réservé lui-même, site ou application
  /// PHONE   le professionnel l'a saisi pendant un appel
  /// MANUAL  le professionnel l'a saisi sans appel (passage, report…)
  ///
  /// Purement informatif : les trois passent par le même moteur et les mêmes
  /// règles de disponibilité. C'est ce qui permettra de dire « 45 en ligne,
  /// 32 par téléphone » sans avoir deux systèmes à réconcilier.
  source String @default("ONLINE")

  /// PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  ///
  /// Les quatre premiers occupent le créneau ; CANCELLED et NO_SHOW le
  /// libèrent. La contrainte d'exclusion PostgreSQL applique exactement cette
  /// règle (cf. migration).
  status String @default("PENDING")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  /// Qui a annulé : CUSTOMER | PRO | SYSTEM.
  cancelledBy  String?

  @@index([profileId, startAt])
  @@index([memberId, startAt])
  @@index([customerId, startAt])
  @@index([status, startAt])
}

/// Règles de réservation de l'établissement. Une ligne par fiche pro.
/// Toutes les valeurs par défaut correspondent à un salon classique : on doit
/// pouvoir publier sans rien régler.
model ProBookingSettings {
  id        String     @id @default(cuid())
  profileId String     @unique
  profile   ProProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Pas de la grille de créneaux proposés (15 min → 14h00, 14h15, 14h30…).
  slotGranularityMin Int @default(15)
  /// Battement ajouté après chaque rendez-vous (remise en état du poste).
  bufferMin          Int @default(0)
  /// Délai mini avant le début : on ne réserve pas pour dans 5 minutes.
  minNoticeMin       Int @default(120)
  /// Horizon maxi de réservation.
  maxAdvanceDays     Int @default(60)

  /// CONFIRMED d'emblée, ou PENDING en attente de validation du pro.
  autoConfirm       Boolean @default(true)
  allowCancel       Boolean @default(true)
  allowReschedule   Boolean @default(true)
  /// Fenêtre en deçà de laquelle le client ne peut plus annuler seul.
  cancelDeadlineMin Int     @default(1440)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// File d'indexation SEO — une ligne par URL publique connue du site.
///
/// Pourquoi cette table existe : l'état d'indexation n'était mesuré nulle part.
/// L'outil externe branché sur le sitemap affichait « 362 pages en file
/// d'attente, 0 soumise » depuis des semaines, sans que rien dans le produit ne
/// puisse dire pourquoi. Le crawl du 11/08 a donné la réponse — 28 URL en 404,
/// 161 en `noindex`, 191 déclarant l'accueil comme canonique — mais il a fallu
/// le faire à la main.
///
/// Cette table rend l'état permanent et interrogeable : chaque URL porte son
/// score, son verdict, ses motifs d'exclusion et ce que Google en dit.
///
/// Distinction volontaire, qui structure toute la colonne `status` :
///
///   DÉCOUVERTE  — Google connaît l'URL (sitemap, lien). Nous la contrôlons.
///   EXPLORATION — Googlebot l'a téléchargée. Nous ne la contrôlons pas.
///   INDEXATION  — Google a décidé de la garder. Nous ne la contrôlons pas.
///   CLASSEMENT  — hors périmètre de cette table.
///
/// Aucun mécanisme ne permet d'imposer l'indexation d'une URL à Google :
/// l'Indexing API officielle est restreinte aux types `JobPosting` et
/// `BroadcastEvent`. `submittedAt` ne concerne donc qu'IndexNow (Bing, Yandex),
/// et les états DISCOVERED / CRAWLED / INDEXED proviennent en lecture seule de
/// l'API URL Inspection de Search Console. Rien n'est déduit ni supposé.
model SeoUrl {
  id   String @id @default(cuid())
  /// URL absolue, canonique, sans paramètre.
  url  String @unique
  /// Chemin seul, pour les jointures et l'affichage.
  path String

  /// LISTING | CATEGORY | SUBCATEGORY | CITY | CATEGORY_CITY | BRAND | PRO | EDITORIAL | BLOG | STATIC
  type     String
  /// Identifiant de l'entité source quand il y en a une (id d'annonce, slug pro).
  entityId String?

  /// Score SEO 0-100 issu de `lib/seo/indexability.ts`.
  score            Int     @default(0)
  /// CRITIQUE | HAUTE | NORMALE | BASSE
  priorityBand     String  @default("NORMALE")
  /// Verdict local : la page s'indexe-t-elle de notre côté ?
  indexable        Boolean @default(false)
  /// Motifs d'exclusion sérialisés (tableau JSON de `ExclusionReason`).
  exclusionReasons String  @default("[]")
  /// L'URL est-elle effectivement annoncée au sitemap ?
  inSitemap        Boolean @default(false)

  /// PENDING | ELIGIBLE | EXCLUDED | SUBMITTED | DISCOVERED | CRAWLED | INDEXED | NOT_INDEXED | ERROR | GONE
  status String @default("PENDING")

  /// Dernier code HTTP observé lors d'une vérification.
  httpStatus Int?
  /// Canonical déclaré par la page, tel que lu.
  canonical  String?

  attempts      Int       @default(0)
  lastError     String?
  lastCheckedAt DateTime?

  /// Envoi IndexNow (Bing/Yandex). Jamais Google — l'API ne l'accepte pas.
  submittedAt     DateTime?
  /// Renseignés uniquement depuis l'API URL Inspection de Search Console.
  discoveredAt    DateTime?
  indexedAt       DateTime?
  /// `coverageState` brut renvoyé par Google, conservé mot pour mot.
  coverageState   String?
  /// Canonique retenue par Google, qui peut différer de la nôtre.
  googleCanonical String?

  /// Dernière modification du contenu source — alimente `lastmod`.
  contentUpdatedAt DateTime?
  firstSeenAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([type, status])
  @@index([indexable, score])
  @@index([lastCheckedAt])
  @@index([inSitemap])
}

/// Journal d'exécution des travaux SEO — sert aussi de verrou.
///
/// Deux passages simultanés du même travail produiraient des écritures
/// concurrentes sur `SeoUrl` et un décompte faux. Une exécution en cours et
/// récente bloque la suivante ; au-delà du délai de péremption, on considère
/// que le processus précédent est mort et on repart.
model SeoJobRun {
  id  String @id @default(cuid())
  /// queue-sync | url-inspection
  job String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)

  /// Nombre d'URL traitées sur ce passage.
  processed   Int     @default(0)
  /// Décompte détaillé (créées, mises à jour, exclues…), sérialisé.
  summaryJson String  @default("{}")
  error       String?

  @@index([job, startedAt])
}

// ═════════════════════════════════════════════════════════════════════════
// MOTEUR DE RECOMMANDATION LOCALE
//
// Trois tables de connaissance (où vit un compte, ce qui l'intéresse, ce
// qu'on lui a déjà envoyé) et une table de campagne. Aucune n'est une
// source de vérité : toutes se reconstruisent à partir des annonces, des
// favoris et du journal `UserEvent`. Les perdre coûte un recalcul, pas une
// donnée.
// ═════════════════════════════════════════════════════════════════════════

/// Une zone géographique connue ou supposée d'un compte.
///
/// Un compte en a plusieurs : on ne vit pas là où l'on vend son canapé, et
/// quelqu'un qui déménage garde un pied dans son ancienne ville pendant des
/// mois. Écraser l'ancienne zone à chaque nouvelle annonce ferait perdre cette
/// épaisseur — d'où une ligne par zone, chacune avec son propre niveau de
/// confiance.
///
/// La distinction cardinale est portée par `source` :
///
///   LISTING_PUBLISHED — le compte a publié une annonce ici. Il a choisi cette
///     commune lui-même, en connaissance de cause. Localisation **certaine**.
///   PROFILE_ADDRESS   — adresse déclarée au profil. Certaine également.
///   LISTING_VIEWED    — le compte regarde des annonces situées ici. C'est un
///     intérêt, pas une adresse : on peut consulter des maisons à Biarritz
///     depuis Lille. Localisation **estimée**.
///   SEARCH            — recherche filtrée sur cette zone. Estimée aussi.
///
/// Rien dans le produit ne doit présenter une zone estimée comme une adresse.
model UserLocationProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Clé de déduplication : code INSEE, ou `dept:XX` pour un repli
  /// départemental. Une commune = une ligne, quelle que soit l'orthographe
  /// saisie par l'utilisateur.
  zoneKey    String
  city       String
  department String
  postalCode String?
  lat        Float
  lng        Float
  /// COMMUNE | POSTAL | DEPARTMENT
  precision  String @default("COMMUNE")

  /// LISTING_PUBLISHED | PROFILE_ADDRESS | LISTING_VIEWED | SEARCH
  source String
  /// CERTAIN | ESTIMATED — dérivé de `source`, dupliqué pour filtrer sans
  /// réécrire la logique dans chaque requête.
  certainty String @default("ESTIMATED")

  /// 0 → 100. Combine la nature de la source, le volume d'activité et la
  /// fraîcheur. Recalculé à chaque rafraîchissement, jamais incrémenté.
  confidence Int @default(0)

  listingCount Int @default(0)
  viewCount    Int @default(0)
  searchCount  Int @default(0)

  /// Zone la mieux notée du compte. Une seule par utilisateur.
  isPrimary Boolean @default(false)

  firstActivityAt DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, zoneKey])
  @@index([userId, confidence])
  @@index([lat, lng])
  @@index([certainty, confidence])
}

/// Intérêt d'un compte pour une catégorie Deal&Co.
///
/// Jamais déclaré, toujours déduit. Un compte qui a publié une voiture sait ce
/// qu'est le marché de l'occasion ; un compte qui a ouvert une annonce de moto
/// une fois en huit mois, non. Le score sépare les deux.
///
/// `categoryId` est l'identifiant de `lib/categories.ts` (« immobilier »,
/// « maison », « vehicules »…), pas un libellé : ajouter une catégorie au
/// catalogue suffit à la rendre recommandable, sans toucher à ce fichier.
model UserCategoryInterest {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String

  /// 0 → 100.
  score Int @default(0)

  publishedCount  Int @default(0)
  favoriteCount   Int @default(0)
  viewCount       Int @default(0)
  searchCount     Int @default(0)
  emailClickCount Int @default(0)
  /// Emails reçus sur cette catégorie et jamais ouverts. Signal négatif : au
  /// bout de plusieurs, le compte a répondu, même sans se désabonner.
  ignoredEmailCount Int @default(0)

  lastActivityAt DateTime @default(now())
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId, score])
}

/// Une exécution du moteur pour une catégorie, réelle ou simulée.
///
/// Sert de lot : toutes les recommandations d'un même passage y sont
/// rattachées, ce qui rend l'écran d'administration lisible (qui a été ciblé,
/// combien ont ouvert) et permet de rejouer une campagne en simulation avant
/// de l'envoyer pour de bon.
model RecommendationCampaign {
  id            String @id @default(cuid())
  categoryId    String
  categoryLabel String

  /// Annonces neuves entrées dans le calcul.
  listingCount Int @default(0)
  /// Comptes examinés (pré-filtre géographique passé).
  candidateUsers Int @default(0)
  /// Comptes retenus après scoring, consentement et anti-doublon.
  targetedUsers Int @default(0)
  emailsSent    Int @default(0)
  errors        Int @default(0)

  /// Simulation : tout est calculé et journalisé, rien n'est envoyé.
  dryRun Boolean @default(false)
  /// RUNNING | DONE | FAILED
  status String @default("RUNNING")

  windowStart DateTime
  windowEnd   DateTime
  /// Détail sérialisé : seuils utilisés, motifs d'exclusion agrégés.
  meta        String @default("{}")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  recommendations ListingRecommendationLog[]

  @@index([categoryId, startedAt])
  @@index([startedAt])
}

/// Une annonce recommandée à un compte — décision, justification et suites.
///
/// Cette table est aussi le garde-fou anti-répétition : avant d'inclure une
/// annonce dans un email, on vérifie qu'elle n'y a jamais figuré. La contrainte
/// d'unicité `(userId, listingId)` rend le doublon impossible, y compris si
/// deux exécutions se chevauchent.
///
/// Les scores sont conservés pour pouvoir expliquer une décision six mois plus
/// tard : « pourquoi ce compte a-t-il reçu ça ? » doit avoir une réponse.
model ListingRecommendationLog {
  id         String  @id @default(cuid())
  campaignId String?
  campaign   RecommendationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// 0 → 100.
  score         Int
  categoryScore Int   @default(0)
  locationScore Int   @default(0)
  recencyScore  Int   @default(0)
  distanceKm    Float?

  /// CERTAIN | ESTIMATED — nature de la position utilisée pour décider. Pilote
  /// aussi l'affichage : on n'écrit « à 4,8 km » que sur une position certaine.
  locationCertainty String @default("ESTIMATED")
  /// Zone de l'utilisateur retenue pour ce rapprochement.
  matchedZoneKey    String?

  /// Rang dans l'email envoyé. -1 en simulation.
  position Int @default(0)

  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, listingId])
  @@index([campaignId])
  @@index([userId, sentAt])
  @@index([listingId, clickedAt])
}
